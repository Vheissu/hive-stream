{
    "name": "hive-stream",
    "version": "3.1.0",
    "description": "A layer for streaming actions on the Hive blockchain and reacting to them.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "hive-stream": "dist/cli/index.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.mjs",
            "require": "./dist/testing/index.js",
            "default": "./dist/testing/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.mjs",
            "require": "./dist/client/index.js",
            "default": "./dist/client/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "DOCUMENTATION.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "repository": "git@github.com:Vheissu/hive-stream.git",
    "homepage": "https://github.com/Vheissu/hive-stream#readme",
    "bugs": {
        "url": "https://github.com/Vheissu/hive-stream/issues"
    },
    "keywords": [
        "hive",
        "hive-blockchain",
        "blockchain",
        "hive-engine",
        "dhive",
        "smart-contracts",
        "streaming",
        "dapp",
        "web3",
        "crypto"
    ],
    "engines": {
        "node": ">=18"
    },
    "author": "Dwayne Charrington <dwaynecharrington@gmail.com>",
    "license": "MIT",
    "private": false,
    "scripts": {
        "clean": "node scripts/clean-dist.js",
        "build": "npm run clean && tsc --project tsconfig.build.json && node scripts/generate-esm-wrappers.js",
        "start": "npx ts-node src/test.ts",
        "watch": "tsc -w",
        "test": "jest --verbose",
        "clean-tests": "jest --clearCache",
        "docs:gen": "ts-node scripts/generate-contract-docs.ts",
        "docs:dev": "npm run docs:gen && vitepress dev docs",
        "docs:build": "npm run docs:gen && vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@hiveio/dhive": "^1.2.4",
        "better-sqlite3": "^12.2.0",
        "bignumber.js": "^9.3.1",
        "bson": "^6.10.4",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "knex": "^3.1.0",
        "mongodb": "^6.18.0",
        "pg": "^8.16.3",
        "seedrandom": "^3.0.5",
        "uuid": "^11.1.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/bytebuffer": "^5.0.49",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.1.0",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.15.5",
        "@types/seedrandom": "^3.0.8",
        "jest": "^30.0.5",
        "jest-cli": "^30.0.5",
        "jest-fetch-mock": "^3.0.3",
        "mongodb-memory-server": "^10.1.4",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "vitepress": "^1.6.4"
    }
}
