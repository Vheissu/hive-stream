{
    "name": "hive-stream",
    "version": "5.0.0",
    "description": "A layer for streaming actions on the Hive blockchain and reacting to them.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "hive-stream": "dist/cli/index.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.mjs",
            "require": "./dist/testing/index.js",
            "default": "./dist/testing/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.mjs",
            "require": "./dist/client/index.js",
            "default": "./dist/client/index.js"
        },
        "./scaffold": {
            "types": "./dist/scaffold/index.d.ts",
            "import": "./dist/scaffold/index.mjs",
            "require": "./dist/scaffold/index.js",
            "default": "./dist/scaffold/index.js"
        },
        "./catalog": {
            "types": "./dist/catalog/index.d.ts",
            "import": "./dist/catalog/index.mjs",
            "require": "./dist/catalog/index.js",
            "default": "./dist/catalog/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "DOCUMENTATION.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/Vheissu/hive-stream.git"
    },
    "homepage": "https://github.com/Vheissu/hive-stream#readme",
    "bugs": {
        "url": "https://github.com/Vheissu/hive-stream/issues"
    },
    "keywords": [
        "hive",
        "hive-blockchain",
        "blockchain",
        "hive-engine",
        "dhive",
        "smart-contracts",
        "streaming",
        "dapp",
        "web3",
        "crypto"
    ],
    "engines": {
        "node": ">=22"
    },
    "author": "Dwayne Charrington <dwaynecharrington@gmail.com>",
    "license": "MIT",
    "private": false,
    "scripts": {
        "clean": "node scripts/clean-dist.js",
        "build": "npm run clean && node scripts/generate-version.js && npm run catalog:gen && tsc --project tsconfig.build.json && node scripts/generate-esm-wrappers.js",
        "start": "tsx src/test.ts",
        "watch": "tsc -w",
        "test": "jest --verbose",
        "clean-tests": "jest --clearCache",
        "catalog:gen": "tsx scripts/generate-contract-catalog.ts",
        "docs:gen": "tsx scripts/generate-contract-docs.ts",
        "docs:dev": "npm run docs:gen && vitepress dev docs",
        "docs:build": "npm run docs:gen && vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@hiveio/dhive": "^1.3.6",
        "better-sqlite3": "^13.0.3",
        "bignumber.js": "^11.1.5",
        "cors": "^2.8.6",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "knex": "^3.3.0",
        "seedrandom": "^3.0.5",
        "zod": "^4.6.5"
    },
    "peerDependencies": {
        "mongodb": "^7.0.0",
        "pg": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "mongodb": {
            "optional": true
        },
        "pg": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/bytebuffer": "^5.0.49",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.20.4",
        "@types/pg": "^8.23.1",
        "@types/seedrandom": "^3.0.8",
        "jest": "^30.5.2",
        "jest-fetch-mock": "^4.2.0",
        "mongodb": "^7.6.0",
        "pg": "^8.23.0",
        "ts-jest": "^29.4.14",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "vitepress": "^1.6.4"
    },
    "overrides": {
        "vitepress": {
            "vite": "^6.4.3"
        }
    }
}
